parameters:
    level: 9
    paths:
        - src
        - tests
    tipsOfTheDay: false
    treatPhpDocTypesAsCertain: false
    # PHPStan 2 removed the checkMissingIterableValueType toggle; this restores the
    # project's prior policy of not requiring value types on plain array shapes.
    ignoreErrors:
        -
            identifier: missingType.iterableValue
